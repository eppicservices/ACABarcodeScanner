# Caddyfile for ACA Barcode Scanner
# Replace your-domain.com with your actual domain

your-domain.com {
    reverse_proxy app:3000

    # Enable compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

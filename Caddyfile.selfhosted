# Caddyfile for Self-Hosted ACA Barcode Scanner
# Replace your-domain.com with your actual domain

your-domain.com {
    # Main application
    handle /api/* {
        reverse_proxy app:3000
    }

    handle /* {
        reverse_proxy app:3000
    }

    # Enable compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Supabase API endpoint (optional subdomain)
# Uncomment if you want api.your-domain.com for Supabase
# api.your-domain.com {
#     reverse_proxy kong:8000
#     encode gzip
# }

# Supabase Studio (optional subdomain)
# Uncomment if you want studio.your-domain.com for admin dashboard
# studio.your-domain.com {
